# Google Calendar + Meet (for mentor "Join Call")
# Create credentials at https://console.cloud.google.com/
# Enable: Google Calendar API
# OAuth client type: Web application
# Authorized redirect URI: http://127.0.0.1:5173/oauth/google/callback

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/oauth/google/callback

# Optional: use one Google account for all mentors in dev (refresh token from OAuth playground)
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Email verification (dev: emails print in Django runserver console)
FRONTEND_URL=http://127.0.0.1:5173
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=NewRuz <your@gmail.com>
